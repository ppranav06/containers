# N8N config

# Tailscale
TAILSCALE_HOSTNAME=
TAILSCALE_AUTH_KEY=

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=

# Public hostnames
# This variable is the tailscale domain
DOMAIN_NAME=
N8N_DOMAIN=${TAILSCALE_HOSTNAME}.${DOMAIN_NAME}
WEBHOOK_DOMAIN=

# Security
# (create one using openssl rand -hex 69)
N8N_ENCRYPTION_KEY=

# Timezone
GENERIC_TIMEZONE=

